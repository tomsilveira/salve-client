{
  "$schema": "https://tauri.app/schema/tauri.conf.json",
  "identifier": "com.salve.app",
  "productName": "Salve",
  "version": "0.1.0",
  "build": {
    "devUrl": "https://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' 'unsafe-eval' ws: wss: http: https: turn:; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' blob: mediastream:; frame-src 'self'; object-src 'none'"
    },
    "windows": [
      {
        "title": "Salve",
        "width": 1200,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
